{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "gh pr create*": "ask",
      "pnpm add *": "ask",
      "pnpm install *": "ask",
      "npm install *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "*--no-verify*": "deny"
    },
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      ".oxlintrc.json": "ask",
      "vite.config.ts": "ask",
      "package.json": "ask",
      "pnpm-lock.yaml": "ask",
      "helm/**": "ask",
      ".agent/**": "ask",
      ".opencode/**": "ask",
      ".claude/**": "ask",
      ".codex/**": "ask",
      "**/.env*": "deny",
      "src/apis/**": "deny",
      "src/routeTree.gen.ts": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/.ssh/**": "deny",
      "~/.ssh/**": "deny"
    },
    "external_directory": {
      "*": "ask"
    }
  }
}
