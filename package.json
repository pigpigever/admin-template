{
  "name": "admin-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-env.mjs development && vite",
    "build": "node scripts/sync-env.mjs production && tsc -b && vite build",
    "serve": "vite preview",
    "extract": "lingui extract --clean",
    "api:gen": "dune generateApi",
    "env:sync": "node scripts/sync-env.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node docs/.scripts/check-docs.mjs",
    "test:layout": "node docs/.scripts/check-tests.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm test:layout",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.15-8",
    "@dune2/tools": "^1.5.0",
    "@lingui/core": "^5.1.2",
    "@lingui/react": "^5.1.2",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "@tanstack/react-router": "^1.95.0",
    "@tanstack/router-devtools": "^1.95.0",
    "@tanstack/router-plugin": "^1.95.0",
    "antd": "^6.6.8",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.53.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dune2/cli": "^2.0.2",
    "@lingui/babel-plugin-lingui-macro": "5.9.5",
    "@lingui/cli": "^5.1.2",
    "@lingui/vite-plugin": "^5.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.95.0",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint-plugin-lingui": "^0.16.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "oxlint --fix --deny-warnings"
  },
  "pnpm": {
    "shamefullyHoist": true
  }
}
